# Normalize line endings for cross-platform development.
* text=auto eol=lf

*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.aar binary
*.so binary
*.dll binary
*.apk binary
*.aab binary
