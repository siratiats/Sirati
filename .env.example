APP_NAME=Sirati
APP_ENV=local
APP_KEY=

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30
OPENAI_CONNECT_TIMEOUT=5

# CV AI provider: openai (default/production) | deepinfra (fast backup) | claude (bake-off only)
CV_AI_PROVIDER=deepinfra
CV_AI_RESPONSE_CACHE_ENABLED=true

DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=Qwen/Qwen2.5-72B-Instruct
DEEPINFRA_MODEL_AR=Qwen/Qwen2.5-72B-Instruct
DEEPINFRA_MODEL_EN=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
DEEPINFRA_FAST_MODEL=mistralai/Mistral-Small-24B-Instruct-2501
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_TIMEOUT=45
DEEPINFRA_CONNECT_TIMEOUT=5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT=30
ANTHROPIC_CONNECT_TIMEOUT=5
ADMIN_ACCESS_TOKEN=
ADMIN_EMAILS=
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT=app
FIREBASE_HTTP_CLIENT_TIMEOUT=10
# Public Google Sheets CSV URL used by jobs:sync-sheet (File > Share > Publish to web > CSV)
JOBS_SHEET_CSV_URL=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
HEALTH_QUEUE_CHECK_ENABLED=true
# HEALTH_QUEUE_CONNECTION=redis
HEALTH_QUEUE_MAX_AGE_SECONDS=120

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.privateemail.com
MAIL_PORT=587
MAIL_USERNAME=info@siratie.com
MAIL_PASSWORD=ej75p.hy*MUJ.re
MAIL_FROM_ADDRESS="info@siratie.com"
# MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=mail.privateemail.com
# MAIL_PORT=587
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="you@siratie.com"
# MAIL_FROM_NAME="${APP_NAME}"
# OTP validity in minutes for mobile email verification
AUTH_VERIFICATION_EXPIRE=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
